      "html": "<a class=\"ds-btn ds-btn-gold\" href=\"#\"><svg class=\"ds-ico\" viewBox=\"0 0 24 24\"><path d=\"M5 3h3.5l1.8 4.6-2.4 1.6a12 12 0 0 0 6 6l1.6-2.4L20 14.6V18a3 3 0 0 1-3 3A16 16 0 0 1 2 6a3 3 0 0 1 3-3z\"/></svg>Call (732) 344-0712</a>",
      "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:var(--btn-h,58px);padding:0 22px;border-radius:999px;border:3px solid var(--gold,#f9bf00);font:800 1.0625rem/1 var(--font,system-ui,sans-serif);text-decoration:none;cursor:pointer;transition:background-color .2s,color .2s,transform .2s cubic-bezier(.2,.8,.2,1);white-space:nowrap}.ds-btn:active{transform:scale(.97)}.ds-btn:focus-visible{outline:3px solid var(--gold,#f9bf00);outline-offset:3px}.ds-btn-gold{background:var(--gold,#f9bf00);color:var(--ink,#10233d);box-shadow:0 10px 22px -10px rgba(249,191,0,.75)}.ds-btn-gold:hover{background:#ffcb1f}.ds-ico{width:22px;height:22px;fill:none;stroke:currentColor;stroke-width:2.2;stroke-linecap:round;stroke-linejoin:round}"
